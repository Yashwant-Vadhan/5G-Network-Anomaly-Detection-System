# 5G-NADS environment template.
#
# No secret is required for the MVP (docs/planning/TECH_RULES.md, Security
# Rules). Copy to `.env` for local use; `.env` is git-ignored and must never
# be committed. Placeholders only — do not put real credentials here.

# --- Optional local LLM explainer (Phase 9, nice-to-have) ---
# Must stay false for the core pipeline: the anomaly decision and the agent
# explanations are deterministic Python and must not depend on an LLM (G13).
NADS_USE_LLM=false

# Local Ollama endpoint, used only when NADS_USE_LLM=true and the optional
# explainer is implemented. Plain HTTP to localhost, no API key.
OLLAMA_URL=http://localhost:11434

# --- v2 Streaming Server (Contracts C7, C8, C9) ---
# Bind host and port. Non-loopback host (e.g. 0.0.0.0) requires NADS_ALLOW_LAN=true
# and a non-empty NADS_INGEST_TOKEN.
NADS_HOST=127.0.0.1
NADS_PORT=8000

# 32-byte CSPRNG token for phone telemetry ingest authentication.
# Generate a new token anytime with: `make token`
NADS_INGEST_TOKEN=placeholder-generate-token-with-make-token

# Non-loopback network exposure guards (G18)
NADS_ALLOW_LAN=false
NADS_ALLOW_REMOTE_VIEW=false

# --- External Alert Dispatcher Channels (C9) ---
# Webhook notification target URL (empty = disabled)
NADS_ALERT_WEBHOOK_URL=https://webhook.example.com/alerts-placeholder

# SMTP notification settings (disabled if host is unset)
NADS_ALERT_EMAIL_HOST=smtp.example.com
NADS_ALERT_EMAIL_PORT=587
NADS_ALERT_EMAIL_USER=alerts@example.com
NADS_ALERT_EMAIL_PASSWORD=placeholder-smtp-password
NADS_ALERT_EMAIL_FROM=alerts@example.com
NADS_ALERT_EMAIL_TO=oncall@example.com

# Privacy guard (G26): when false, webhook and email alerts omit cell IDs,
# device identifiers, and raw measurements.
NADS_ALERT_INCLUDE_EVIDENCE=false
