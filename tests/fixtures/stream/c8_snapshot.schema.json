  "description": "Initial connection snapshot emitted to newly connected live subscribers (C8).",
  "properties": {
    "last_alerts": {
      "items": {
        "type": "object"
      },
      "title": "Last Alerts",
      "type": "array"
    },
    "latest_sample": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoredSample"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "open_events": {
      "items": {
        "$ref": "#/$defs/EventRecord"
      },
      "title": "Open Events",
      "type": "array"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "server_time": {
      "title": "Server Time",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "LIVE",
        "STALE",
        "RECONNECTING",
        "WAITING",
        "DISCONNECTED",
        "REPLAY-SOURCE"
      ],
      "title": "State",
      "type": "string"
    },
    "type": {
      "const": "snapshot",
      "default": "snapshot",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "server_time",
    "session_id",
    "state"
  ],
  "title": "SnapshotEvent",
  "type": "object"
}
