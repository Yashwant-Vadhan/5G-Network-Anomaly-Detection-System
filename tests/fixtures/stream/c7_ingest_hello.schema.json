{
  "$defs": {
    "EdgeHelloInfo": {
      "description": "Optional edge inference status reported during hello handshake.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "feature_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feature Hash"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        }
      },
      "title": "EdgeHelloInfo",
      "type": "object"
    }
  },
  "description": "Initial client hello message upon WebSocket connection (C7).",
  "properties": {
    "android": {
      "maxLength": 50,
      "title": "Android",
      "type": "string"
    },
    "app_version": {
      "maxLength": 50,
      "title": "App Version",
      "type": "string"
    },
    "client_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Client Id",
      "type": "string"
    },
    "device": {
      "maxLength": 100,
      "title": "Device",
      "type": "string"
    },
    "dropped_from_queue": {
      "default": 0,
      "minimum": 0,
      "title": "Dropped From Queue",
      "type": "integer"
    },
    "edge": {
      "anyOf": [
        {
          "$ref": "#/$defs/EdgeHelloInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "manufacturer": {
      "maxLength": 100,
      "title": "Manufacturer",
      "type": "string"
    },
    "operator": {
      "maxLength": 100,
      "title": "Operator",
      "type": "string"
    },
    "queue_depth": {
      "default": 0,
      "minimum": 0,
      "title": "Queue Depth",
      "type": "integer"
    },
    "resume_from_seq": {
      "default": 0,
      "minimum": 0,
      "title": "Resume From Seq",
      "type": "integer"
    },
    "schema_version": {
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_label": {
      "maxLength": 128,
      "title": "Session Label",
      "type": "string"
    },
    "source": {
      "default": "phone",
      "enum": [
        "phone",
        "replay"
      ],
      "title": "Source",
      "type": "string"
    },
    "type": {
      "const": "hello",
      "default": "hello",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "session_label",
    "device",
    "manufacturer",
    "android",
    "operator",
    "app_version"
  ],
  "title": "IngestHello",
  "type": "object"
}
