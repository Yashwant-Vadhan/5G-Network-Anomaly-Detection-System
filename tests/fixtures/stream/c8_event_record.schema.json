{
  "$defs": {
    "AlertDecision": {
      "description": "Decision record indicating whether an event fired an alert and why.",
      "properties": {
        "alerted": {
          "title": "Alerted",
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "NEW",
                "ESCALATION",
                "RESOLVED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "reason": {
          "enum": [
            "Alert triggered",
            "ML-only (no rule evidence)",
            "Transition only",
            "Below persistence/severity threshold",
            "Cooldown active"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "alerted",
        "reason"
      ],
      "title": "AlertDecision",
      "type": "object"
    }
  },
